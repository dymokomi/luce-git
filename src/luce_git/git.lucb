import luce_git.object as object
import luce_git.packet as packet

pub type Packet = packet.Packet
pub type PacketKind = packet.Kind

pub func decode_packet(input: const u8[]) -> Packet!:
    return try packet.decode(input)

pub func encode_packet(kind: PacketKind, payload: const u8[], output: u8[]) -> usize!:
    return try packet.encode(kind, payload, output)

pub let invalid = object.invalid
pub type Object = object.Object

pub func encode_object(kind: str, payload: const u8[], out: u8[]) -> usize!:
    return try object.encode(kind, payload, out)

pub func decode_object(input: const u8[]) -> Object!:
    return try object.decode(input)

pub func hash_object(kind: str, payload: const u8[], out: u8[]) -> usize!:
    return try object.hash_object(kind, payload, out)

pub func hash_blob(payload: const u8[], out: u8[]) -> usize!:
    return try object.hash_blob(payload, out)

pub func hex_id(id: const u8[], out: u8[]) -> usize!:
    return try object.hex_id(id, out)
